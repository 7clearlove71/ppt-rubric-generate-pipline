{
  "version": "0.1.0",
  "base_url": "https://api.modelarts-maas.com/openai/v1",
  "generator_model": "glm-5.2",
  "vision_model": "kimi-k2.6",
  "reviewer_model": "kimi-k2.6",
  "judge_model": "kimi-k2.6",
  "keychain_service": "codex.modelarts-maas.api-key",
  "keychain_account": "codex",
  "trust_env_proxy": false,
  "timeout_seconds": 180,
  "max_retries": 3,
  "max_output_tokens": 16000,
  "request_options": {
    "thinking": {
      "type": "disabled"
    }
  },
  "api_concurrency": 1,
  "max_revisions": 2,
  "dpi": 150,
  "pdf_backend": "pymupdf",
  "soffice": "soffice",
  "font_dirs": [],
  "dimension_weights": {
    "fulfillment": 30,
    "correctness": 25,
    "integrity": 15,
    "narrative": 15,
    "visual": 15
  },
  "max_case_text_chars": 100000,
  "max_images_per_request": 60,
  "tie_margin": 3.0,
  "min_request_interval_seconds": 20,
  "rate_limit_backoff_seconds": 30,
  "max_consecutive_rate_limits": 3,
  "evaluation_protocol": "evidence_v1",
  "max_api_requests": 12,
  "pipeline_stage": "rubric"
}
