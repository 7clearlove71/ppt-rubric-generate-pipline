  "items": [
    {
      "id": "R01",
      "group_id": "G01",
      "importance": 3,
      "source_refs": [
        "Q01"
      ],
      "basis": "explicit",
      "scope": "全篇交付形态",
      "evidence_mode": "both",
      "judge_prompt": "原始田野笔记被整理为一份可供展示的PPT成品：内容经过结构化组织（有封面/标题、按天或按主题划分的内容模块、总结性页面等可辨识的演示文稿结构），而非原文段落的简单复制粘贴或纯文档式排版。满足记yes；仅为原文文字的直接搬运、无任何演示文稿化整理，记no。",
      "dimension": "fulfillment",
      "score": 18.0
    },
    {
      "id": "R06",
      "group_id": "G02",
      "importance": 3,
      "source_refs": [
        "Q09"
      ],
      "basis": "explicit",
      "scope": "全篇存疑信息的呈现方式",
      "evidence_mode": "both",
      "judge_prompt": "原文中存疑的信息（至少包括：族谱说法'待考、得多问几个人'、木雕建筑'来历说不清'）在PPT中以可辨识的方式标注为待核实/存疑，例如使用'待考''存疑''待核实'标签、专门的存疑版块、或明确的视觉标记（如问号图标、特殊色块）。两类存疑信息均有显式标注记yes；只标注了其中一类、或仅在正文中顺带提及而无可辨识的标注形式，记no。",
      "dimension": "fulfillment",
      "score": 12.0
    },
    {
      "id": "R07",
      "group_id": "G03",
      "importance": 3,
      "source_refs": [
        "Q04"
      ],
      "basis": "explicit",
      "scope": "Day1对应内容，不限定页码与版式",
      "evidence_mode": "both",
      "judge_prompt": "Day1观察内容存在且准确：现存明清老宅约40栋（允许'40余栋''近40栋'等保留'约'意的表述，不得写成精确40栋或其他数值）；住人不到一半（不得写成'一半以上'或改为其他比例）；年轻人外出打工；留守多为老人。四要素均出现且与原文含义一致记yes；任一要素缺失、数值被篡改或含义改变，记no。允许等价表述（如'不足半数有人居住''常住人口以老人为主'）。",
      "dimension": "correctness",
      "score": 4.411764705882353
    },
    {
      "id": "R08",
      "group_id": "G03",
      "importance": 3,
      "source_refs": [
        "Q05"
      ],
      "basis": "explicit",
      "scope": "Day2对应内容，不限定页码与版式",
      "evidence_mode": "both",
      "judge_prompt": "Day2访谈内容存在且准确：祠堂祭祖由过去每年清明举行变为现在三年一次（频率与时间点均不得改动）；有老人称族谱在文革期间被烧毁一部分；现存版本是后来凭记忆补写的；族谱说法保持为'有老人说'的访谈说法，未改写为调研者确认的史实。各要素均出现、数值准确且来源归属正确记yes；要素缺失、频率或时间被改动、或将老人说法写成确定事实，记no。",
      "dimension": "correctness",
      "score": 4.411764705882353
    },
    {
      "id": "R09",
      "group_id": "G03",
      "importance": 3,
      "source_refs": [
        "Q06"
      ],
      "basis": "explicit",
      "scope": "Day3对应内容，不限定页码与版式",
      "evidence_mode": "both",
      "judge_prompt": "Day3观察内容存在且准确：民居多为天井院落式；其中几栋木雕风格明显不同；木雕建筑为'外姓人'所建保持为'村民说'的说法且来历说不清，未改写为已确认的建造者身份。各要素均出现且归属正确记yes；要素缺失、或将村民说法写成确定结论，记no。允许等价表述（如'非本族人所建''来源不明'）。",
      "dimension": "correctness",
      "score": 4.411764705882353
    },
    {
      "id": "R10",
      "group_id": "G03",
      "importance": 3,
      "source_refs": [
        "Q07"
      ],
      "basis": "explicit",
      "scope": "Day4对应内容，不限定页码与版式",
      "evidence_mode": "both",
      "judge_prompt": "Day4观察内容存在且准确：村里进行旅游开发、新修了仿古街；老宅本体保护缺乏资金投入；两者形成保护与开发的矛盾。三要素均出现且含义与原文一致记yes；要素缺失或矛盾关系被改写（如写成保护资金充足、开发与保护协调），记no。允许等价表述（如'资金投向仿古建筑而非老宅修缮'）。",
      "dimension": "correctness",
      "score": 4.411764705882353
    },
    {
      "id": "R11",
      "group_id": "G03",
      "importance": 3,
      "source_refs": [
        "Q08"
      ],
      "basis": "explicit",
      "scope": "初步感受/后续方向对应内容，不限定页码与版式",
      "evidence_mode": "both",
      "judge_prompt": "三点初步方向存在且准确：空心化、文化记忆断层、保护与开发错位三个概念均出现，且被定位为'初步感受/后续方向'而非最终研究结论。三点齐全、表述与原文含义一致且定位准确记yes；缺任一点、概念被替换为不同含义、或写成已验证的最终结论，记no。允许等价措辞（如'人口空心化''记忆断裂''保护与开发失衡'）。",
      "dimension": "correctness",
      "score": 4.411764705882353
    },
    {
      "id": "R12",
      "group_id": "G03",
      "importance": 2,
      "source_refs": [
        "Q04",
        "Q05",
        "Q06",
        "Q07"
      ],
      "basis": "explicit",
      "scope": "全篇事实对应关系",
      "evidence_mode": "both",
      "judge_prompt": "若PPT按天或按主题标注了内容的时间/来源线索，四天观察内容之间不出现张冠李戴（如把旅游开发写成Day2的观察、把木雕风格差异归入访谈内容）；若采用主题式重组而未保留时间线，同一主题下的原始事实归属仍正确（如祠堂祭祖变迁不与民居建筑观察混淆）。对应关系均正确记yes；出现事实归属错乱记no。",
      "dimension": "correctness",
      "score": 2.9411764705882355
    },
    {
      "id": "R13",
      "group_id": "G05",
      "importance": 3,
      "source_refs": [
        "Q09"
      ],
      "basis": "explicit",
      "scope": "全篇结论性表述",
      "evidence_mode": "both",
      "judge_prompt": "PPT对存疑内容不下定论：未将'族谱文革被烧、凭记忆补写'写成已证实的历史事实，未对木雕建筑的建造者身份、年代、来历给出确定性结论（如断定其为某姓氏、某年代所建），'空心化、文化记忆断层、保护与开发错位'保持为初步判断而非最终定论。均满足记yes；出现任一处将存疑信息或初步判断写成定论，记no。",
      "dimension": "integrity",
      "score": 9.0
    },
    {
      "id": "R14",
      "group_id": "G05",
      "importance": 2,
      "source_refs": [
        "Q01"
      ],
      "basis": "quality",
      "scope": "全篇新增信息",
      "evidence_mode": "both",
      "judge_prompt": "PPT未虚构原文没有的具体事实：村庄名称、地理位置、调研者身份、具体人名、新增数据（如人口数、收入、游客量）、新增事件或引语均未提供，作品中不应出现此类编造的具体信息。允许与古村落保护领域常识一致的一般性背景表述（如'空心化是传统村落普遍面临的挑战'这类概括），允许明确标注为建议/设想的后续计划；出现无来源的具体名称、数字、事件或捏造的老人引语，记no。",
      "dimension": "integrity",
      "score": 6.0
    },
    {
      "id": "R15",
      "group_id": "G06",
      "importance": 2,
      "source_refs": [
        "Q03"
      ],
      "basis": "explicit",
      "scope": "整体结构与篇幅",
      "evidence_mode": "both",
      "judge_prompt": "作品适合沙龙口头展示场景：有清晰的整体结构（如封面导入、按天或按主题展开的观察主体、总结与后续方向、结尾），单页信息量适合投影讲解而非大段文字堆砌，整体篇幅与一次沙龙分享的讲解负荷相称（既不过于单薄无法支撑分享，也不臃肿到无法讲完）。满足记yes；结构混乱难以跟随、或页面文字密度接近文档而非演示文稿，记no。",
      "dimension": "narrative",
      "score": 7.5
    },
    {
      "id": "R16",
      "group_id": "G07",
      "importance": 2,
      "source_refs": [
        "Q01",
        "Q08"
      ],
      "basis": "explicit",
      "scope": "全篇叙事组织",
      "evidence_mode": "both",
      "judge_prompt": "作品体现了从'田野观察'到'初步判断'的整理与递进：四天的具体观察与最后的三点方向（空心化、文化记忆断层、保护与开发错位）之间能建立可辨识的呼应关系（如按主题归类、在总结处回扣对应观察、或按天呈现后归纳），而非观察与结论互不相干地罗列。允许按时间线或按主题线两种组织方式，任一方式下呼应关系清晰记yes；观察与三点方向完全脱节记no。",
      "dimension": "narrative",
      "score": 7.5
    },
    {
      "id": "R17",
      "group_id": "G08",
      "importance": 3,
      "source_refs": [
        "Q02",
        "Q10"
      ],
      "basis": "explicit",
      "scope": "全篇视觉设计",
      "evidence_mode": "visual",
      "judge_prompt": "作品整体视觉风格大气、有表现力：页面留有适度呼吸空间而非拥挤堆砌；视觉风格统一（配色、字体、版式语言协调一致）；与古村落/田野主题契合的视觉处理（如沉稳的色调、有质感的标题处理、恰当的留白或意象运用）；关键页面（封面、三点方向总结等）有视觉记忆点。允许不同的具体风格路线（沉稳人文风、现代简约风等），整体达到'大气、出彩'记yes；风格杂乱、套用默认模板感强、或视觉平淡无任何设计意图，记no。",
      "dimension": "visual",
      "score": 9.0
    },
    {
      "id": "R18",
      "group_id": "G09",
      "importance": 2,
      "source_refs": [
        "Q03"
      ],
      "basis": "quality",
      "scope": "全篇排版",
      "evidence_mode": "visual",
      "judge_prompt": "投影场景下的可读性：标题与正文的层级对比清晰，观众能快速识别每页主题；正文字号适合远距离观看，无大面积过小文字；文字与背景对比充分，无因配色或底图导致的阅读困难；单页信息密度适中，无文字溢出、重叠、被裁切等排版缺陷。均满足记yes；存在影响阅读的小字、低对比或明显排版错误记no。",
      "dimension": "visual",
      "score": 4.0
    },
    {
      "id": "R19",
      "group_id": "G09",
      "importance": 1,
      "source_refs": [
        "Q02"
      ],
      "basis": "quality",
      "scope": "全篇视觉元素的使用",
      "evidence_mode": "visual",
      "judge_prompt": "若使用了图片、图标、色块、示意图等视觉元素，它们服务于内容表达（如用时间线呈现四天进程、用对比呈现保护与开发矛盾、用图标区分已确认与存疑信息），而非纯装饰或与内容无关的填充。未使用任何视觉元素时，只要版式本身层级清晰、不空洞单调，同样记yes；视觉元素与内容无关、喧宾夺主或质量低劣（模糊、变形、水印）记no。",
      "dimension": "visual",
      "score": 2.0
    }
  ],
