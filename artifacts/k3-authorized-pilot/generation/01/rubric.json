  "items": [
    {
      "id": "R04",
      "group_id": "G02",
      "importance": 3,
      "source_refs": [
        "Q07"
      ],
      "basis": "explicit",
      "scope": "技术路线图模块，不限定位置与形式",
      "evidence_mode": "both",
      "judge_prompt": "PPT包含可辨识的技术路线图：以结构化方式（时间轴、阶段流程、泳道矩阵或等价形式）呈现团队技术发展的路径，且路线内容与所述三项进展相关联（如从当前进展延伸到未来方向）。仅在文字中提及“路线图”一词而无结构化呈现记 no；路线图的具体图形形式不限，未来年份与阶段目标属于合理规划内容，判断重点是路线是否结构化、是否与已有进展衔接。",
      "dimension": "fulfillment",
      "score": 9.0
    },
    {
      "id": "R05",
      "group_id": "G02",
      "importance": 3,
      "source_refs": [
        "Q08"
      ],
      "basis": "explicit",
      "scope": "下一步计划模块，不限定位置",
      "evidence_mode": "text",
      "judge_prompt": "PPT包含明确的下一步计划：面向未来的具体工作安排或目标（如后续研发方向、量产推进、临床推进、时间节点或里程碑中的至少两项），而非一句空泛的“继续努力”。计划内容可与路线图合并呈现，只要未来工作部分可辨识即算满足；规划性内容以规划口吻标注即可，不要求使用“计划”字样。",
      "dimension": "fulfillment",
      "score": 9.0
    },
    {
      "id": "R06",
      "group_id": "G03",
      "importance": 2,
      "source_refs": [
        "Q01"
      ],
      "basis": "explicit",
      "scope": "全篇",
      "evidence_mode": "text",
      "judge_prompt": "PPT整体定位为年会特邀报告：有明确的报告主题与标题页或开场页，内容聚焦“柔性电子团队近三年进展”这一主线，全篇围绕该主线组织，不偏离为产品宣传、科普介绍或其他无关主题。",
      "dimension": "fulfillment",
      "score": 12.0
    },
    {
      "id": "R07",
      "group_id": "G04",
      "importance": 3,
      "source_refs": [
        "Q02"
      ],
      "basis": "explicit",
      "scope": "出现良率数据的任意位置",
      "evidence_mode": "text",
      "judge_prompt": "PPT中可拉伸传感器阵列量产良率的事实准确：起点为78%、提升至92%，两个数值均出现且无篡改（如写成75%→95%、提升20个百分点等错误表述均不通过）。以图表、文字或图示呈现均可；该事实完全缺失也记 no。",
      "dimension": "correctness",
      "score": 5.0
    },
    {
      "id": "R08",
      "group_id": "G04",
      "importance": 3,
      "source_refs": [
        "Q03"
      ],
      "basis": "explicit",
      "scope": "出现OLED弯曲测试数据的任意位置",
      "evidence_mode": "text",
      "judge_prompt": "PPT中柔性OLED器件弯曲测试的事实准确：弯曲次数为10万次（或等价的100,000次/10^5次），且结论为无衰减（或性能无下降等等价表述）。数值被夸大或缩小、结论被改为“轻微衰减”等均不通过；该事实完全缺失也记 no。",
      "dimension": "correctness",
      "score": 5.0
    },
    {
      "id": "R09",
      "group_id": "G04",
      "importance": 3,
      "source_refs": [
        "Q04"
      ],
      "basis": "explicit",
      "scope": "出现电子皮肤合作与临床信息的任意位置",
      "evidence_mode": "text",
      "judge_prompt": "PPT中植入式电子皮肤的事实准确：合作方为三甲医院（未给定具体医院名，写“三甲医院”或明确标注为示例的名称均可），状态为已进入临床试验阶段。将状态改写为“已获批上市”“已完成临床试验”等超出原事实的表述不通过；该事实完全缺失也记 no。",
      "dimension": "correctness",
      "score": 5.0
    },
    {
      "id": "R10",
      "group_id": "G05",
      "importance": 1,
      "source_refs": [],
      "basis": "quality",
      "scope": "全篇",
      "evidence_mode": "text",
      "judge_prompt": "PPT中用户未给定的补充信息与推导在全篇保持一致：同一技术参数、时间范围（近三年）、术语在不同页面间不互相矛盾；若出现对给定数据的衍生计算（如百分点差、不良率、相对变化率），计算结果与所给数据一致（如78%→92%对应不良率22%→8%）；若路线图与下一步计划分处不同页面，两处未来目标数值与时间节点应互相一致。同一成果在不同页面与不同基准对比时，允许分口径对比，但定位性断言（如“领先”“高出X个数量级”）应在全篇保持一致的叙述逻辑。本条不评判用户已给定三项事实本身的准确性。",
      "dimension": "correctness",
      "score": 10.0
    },
    {
      "id": "R11",
      "group_id": "G06",
      "importance": 2,
      "source_refs": [],
      "basis": "quality",
      "scope": "全篇新增内容",
      "evidence_mode": "text",
      "judge_prompt": "PPT未虚构具体事实冒充真实成果：不编造用户未提供的具体医院名称、患者人数、临床试验分期（如I期/II期）、论文数量、经费金额、获奖信息、具体团队成员姓名等并以确定事实口吻呈现；对以确定口吻呈现的团队内部精确数据（如批次统计、Cpk、串扰dB值等），若来源仅自述为“内部数据”而无任何可验证依据，同样视为风险。以“计划”“预期”“目标”等措辞表述的未来设想，或明确标注为示意/示例/外部对标且与给定事实不冲突的内容不算虚构；对未给定的场合性信息（如会议年份、团队名）做低风险具体化补全可接受。",
      "dimension": "integrity",
      "score": 10.0
    },
    {
      "id": "R12",
      "group_id": "G07",
      "importance": 1,
      "source_refs": [],
      "basis": "quality",
      "scope": "全篇",
      "evidence_mode": "text",
      "judge_prompt": "对用户未给定的信息处理得当：若出现具体数据占位或示意（如路线图中的未来指标、待补的合作细节），以占位符、示例标注或目标口吻呈现，使读者能区分给定事实与合理演绎；涉及团队成果与外部对标混排的页面，每项关键数据的归属（团队自有/外部文献/目标）应可被观众明确区分；对给定事实的定性归纳（如成熟度分级、应用阶段判断）若与事实不矛盾，允许作为合理演绎，不要求逐一标注来源。以通识/解读口吻呈现的技术背景（如方法学框架、工程通识）且不冒充具体实验数据，属于合理的专业展开。不要求所有一般性技术背景常识标注来源。",
      "dimension": "integrity",
      "score": 5.0
    },
    {
      "id": "R13",
      "group_id": "G08",
      "importance": 2,
      "source_refs": [
        "Q05"
      ],
      "basis": "explicit",
      "scope": "全篇",
      "evidence_mode": "text",
      "judge_prompt": "内容深度匹配领域内专家受众：包含专业术语与技术性内容（如材料、器件结构、工艺、性能机理层面的讨论），而非仅面向公众的科普化浅层表述；不要求页面标注“专家”字样。全文均为口号式宣传而无技术实质记 no。",
      "dimension": "narrative",
      "score": 6.0
    },
    {
      "id": "R14",
      "group_id": "G08",
      "importance": 2,
      "source_refs": [
        "Q06"
      ],
      "basis": "explicit",
      "scope": "全篇",
      "evidence_mode": "both",
      "judge_prompt": "内容体量与20分钟口头报告匹配：全篇有足以支撑约20分钟讲解的论述展开（三项进展、路线图与计划均有实质内容），同时不过度膨胀到明显无法在20分钟内讲完。判断时同时考虑页数与单页信息密度：单页堆砌多个独立论证模块、需要逐条讲解的密集文字，即使页数适中也可能超出目标时长的可讲范围。不要求页面标注时长；不依据固定页数阈值判断，按信息密度与讲解负荷综合判断。",
      "dimension": "narrative",
      "score": 6.0
    },
    {
      "id": "R15",
      "group_id": "G08",
      "importance": 1,
      "source_refs": [
        "Q01"
      ],
      "basis": "quality",
      "scope": "全篇",
      "evidence_mode": "text",
      "judge_prompt": "叙事结构清晰：存在可辨识的开场（主题引入）、主体（进展展开）与收尾（路线图/计划/总结），阅读顺序合理，各部分内容之间有过渡或逻辑关联，而非内容随机堆叠。",
      "dimension": "narrative",
      "score": 3.0
    },
    {
      "id": "R16",
      "group_id": "G09",
      "importance": 2,
      "source_refs": [],
      "basis": "quality",
      "scope": "全篇",
      "evidence_mode": "visual",
      "judge_prompt": "文字可读性达标：正文与标题字号对比清晰、正文字号在投影场景下可辨认，文字与背景对比度足够，无大面积文字被图形遮挡或溢出页面边界的情况；关键数字与单位（如92%、100,000次）在渲染中不被拆分到不同行或与版式元素重叠；含特殊符号（μm、上标、℃等）的页面渲染后字符完整正确显示；页脚来源与口径说明类文字若存在，其字号在演示场景下应实际可读，不可读的来源标注不计入信息边界处理的正向证据。",
      "dimension": "visual",
      "score": 7.5
    },
    {
      "id": "R17",
      "group_id": "G09",
      "importance": 1,
      "source_refs": [],
      "basis": "quality",
      "scope": "全篇",
      "evidence_mode": "visual",
      "judge_prompt": "视觉层级与阅读路径明确：每页有清晰的主次关系（标题、要点、支撑内容可区分），关键数据在视觉上可被快速定位；单页信息密度适中，不把整段文字无层次地堆满页面；不残留与演示场景不匹配的交互元素（如网页按钮、链接样式控件）。允许不同的版式风格。",
      "dimension": "visual",
      "score": 3.75
    },
    {
      "id": "R18",
      "group_id": "G09",
      "importance": 1,
      "source_refs": [],
      "basis": "quality",
      "scope": "含数据或路线内容的页面",
      "evidence_mode": "visual",
      "judge_prompt": "视觉元素服务于信息表达：若使用图表、图示呈现数据或路线，其类型与内容匹配（如趋势用趋势类图形、流程用流程类图形），图形标注足以让读者理解含义；若全篇未使用任何数据图表，则仅检查装饰性元素不干扰内容阅读，不因缺少图表本身扣分。",
      "dimension": "visual",
      "score": 3.75
    }
  ],
